DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=task-app-nextjs

# En az 32 karakterlik rastgele bir değer kullanın (ör. `openssl rand -base64 48`).
JWT_SECRET=
# Tek kullanımlık kod HMAC anahtarı; boşsa JWT_SECRET kullanılır. Canlı ortamda ayrı değer önerilir.
OTP_SECRET=
NODE_ENV=development

# SMTP Configuration
SMTP_HOST=your_smtp_host
SMTP_PORT=587
SMTP_USER=your_smtp_user
SMTP_PASS=your_smtp_password
EMAIL_FROM="Task App Next.js" <taskappnextjs@yourdomain.com>

